# Copy to keystore.properties (same folder, android-client/) to build a
# signed release APK locally. keystore.properties is gitignored - never
# commit it or the .keystore file itself.
#
# Generate the keystore once, keep it forever:
#   keytool -genkeypair -v -keystore release.keystore -alias voiceledger \
#     -keyalg RSA -keysize 2048 -validity 10000
# Back it up somewhere durable and separate from this repo. If you lose
# it, or its passwords, you can never publish an update under the same
# app identity again - there is no recovery process for this, by design.

storeFile=release.keystore
storePassword=
keyAlias=voiceledger
keyPassword=
