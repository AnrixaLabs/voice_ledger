# Copy to .env and fill in. .env never leaves this machine.

HOST=0.0.0.0
PORT=8420
SERVICE_NAME=Anrixa Voice Ledger

DATA_DIR=./data
DB_PATH=./data/ledger.db

# local = faster-whisper on this machine (offline). azure = cloud STT.
STT_PROVIDER=local
STT_MODEL_SIZE=medium
STT_MODEL_PATH=

# azure = Azure Neural voices (hy-AM-AnahitNeural / hy-AM-HaykNeural). none = no spoken confirmation.
TTS_PROVIDER=azure
TTS_VOICE=hy-AM-AnahitNeural
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Optional: only needed for free-form (single long utterance) capture mode.
ANTHROPIC_API_KEY=
FREEFORM_MODEL=claude-sonnet-4-6
